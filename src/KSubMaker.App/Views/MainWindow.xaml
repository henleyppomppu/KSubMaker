<Window x:Class="KSubMaker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        Title="{x:Static res:Strings.MainWindowTitle}"
        Height="760"
        Width="1420"
        MinHeight="520"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <DockPanel LastChildFill="True">

        <!-- ======================= status bar ======================= -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.QueueStateLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding QueueStateText}" FontWeight="SemiBold" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.CountTotalLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding TotalCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountPendingLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding PendingCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountRunningLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding RunningCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountCompletedLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding CompletedCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountFailedLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding FailedCount}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.GpuLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding GpuSummary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               ToolTip="{Binding GpuSummary}" />
                </StackPanel>
            </StatusBarItem>
            <!-- Pre-start model download. Hidden unless a download is actually running. -->
            <StatusBarItem Visibility="{Binding IsPreparingModels, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="140"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ModelPreparationPercent, Mode=OneWay}"
                                 Margin="0,0,8,0" />
                    <Button Content="{x:Static res:Strings.CancelModelPrepareButton}"
                            Command="{Binding CancelModelPreparationCommand}"
                            Padding="8,0" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="620"
                           ToolTip="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <!-- ======================= folder + scan ======================= -->
        <Border DockPanel.Dock="Top" Padding="12,10,12,6" Background="#F5F6F8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.TargetFolderLabel}"
                               Style="{StaticResource LabelText}" />

                    <TextBox Grid.Column="1"
                             Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                             Padding="5,4"
                             VerticalContentAlignment="Center"
                             ToolTip="{Binding TargetFolder}" />

                    <Button Grid.Column="2"
                            Content="{x:Static res:Strings.SelectFolderButton}"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource CommandButton}"
                            Margin="8,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="{x:Static res:Strings.IncludeSubfoldersLabel}"
                              IsChecked="{Binding IncludeSubfolders}"
                              Style="{StaticResource OptionCheckBox}" />
                    <CheckBox Content="{x:Static res:Strings.IncludeHiddenFoldersLabel}"
                              IsChecked="{Binding IncludeHiddenFolders}"
                              Style="{StaticResource OptionCheckBox}" />
                    <CheckBox Content="{x:Static res:Strings.SkipIfKoreanSubtitleLabel}"
                              IsChecked="{Binding SkipIfKoreanSubtitleExists}"
                              Style="{StaticResource OptionCheckBox}" />

                    <Button Content="{x:Static res:Strings.ScanButton}"
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource CommandButton}" />

                    <Button Content="{x:Static res:Strings.ScanCancelButton}"
                            Command="{Binding CancelScanCommand}"
                            Style="{StaticResource CommandButton}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                    <ProgressBar Width="140"
                                 Height="6"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="6,0,0,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= command bar ======================= -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#F5F6F8">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.StartButton}"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource CommandButton}"
                        FontWeight="SemiBold" />
                <Button Content="{x:Static res:Strings.PauseButton}"
                        Command="{Binding PauseCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.StopButton}"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource CommandButton}" />

                <Rectangle Width="1" Height="24" Fill="#D5D8DD" Margin="4,0,10,0" VerticalAlignment="Center" />

                <Button Content="{x:Static res:Strings.RetryButton}"
                        Command="{Binding RetryCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.CancelJobButton}"
                        Command="{Binding CancelJobsCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.RemoveSelectedButton}"
                        Command="{Binding RemoveSelectedCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.RemoveCompletedButton}"
                        Command="{Binding RemoveCompletedCommand}"
                        Style="{StaticResource CommandButton}" />

                <Rectangle Width="1" Height="24" Fill="#D5D8DD" Margin="4,0,10,0" VerticalAlignment="Center" />

                <Button Content="{x:Static res:Strings.SelectAllButton}"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.ClearSelectionButton}"
                        Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource CommandButton}" />

                <Button Content="{x:Static res:Strings.SubtitleSourceMenuItem}"
                        Command="{Binding ChooseSubtitleSourceCommand}"
                        Style="{StaticResource CommandButton}" />

                <Rectangle Width="1" Height="24" Fill="#D5D8DD" Margin="4,0,10,0" VerticalAlignment="Center" />

                <Button Content="{x:Static res:Strings.OpenOutputFolderButton}"
                        Command="{Binding OpenOutputFolderCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.OpenSourceFolderButton}"
                        Command="{Binding OpenSourceFolderCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.OpenLogButton}"
                        Command="{Binding OpenLogWindowCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.SettingsButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.ModelsButton}"
                        Command="{Binding OpenModelsCommand}"
                        Style="{StaticResource CommandButton}" />
            </WrapPanel>
        </Border>

        <!-- ======================= job grid ======================= -->
        <DataGrid ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  RowHeight="26"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="12,6,12,6">

            <!-- Bound to the window's DataContext, not the row's: a ContextMenu lives in its own
                 visual tree, so {Binding ChooseSubtitleSourceCommand} alone would look for the
                 command on JobRowViewModel and silently disable the item. -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.SubtitleSourceMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.ChooseSubtitleSourceCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.RemoveSelectedButton}"
                              Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Right-click has to select the row before the context menu opens, otherwise
                         "자막 원본 선택" acts on whichever row was last left-clicked. -->
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClick" />

                    <!-- Full path plus the current state, as a plain string so the tooltip content is
                         not a shared visual across every virtualised row. -->
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}&#x0a;{1} · {2}">
                                <Binding Path="FullPath" />
                                <Binding Path="StatusText" />
                                <Binding Path="StageText" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <!-- 선택 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnSelected}" SortMemberPath="IsSelected" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 파일명 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnFileName}" SortMemberPath="FileName" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 길이 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnDuration}"
                                    Binding="{Binding DurationSeconds, Converter={StaticResource SecondsToTime}}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 상태 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnStatus}" SortMemberPath="Status" Width="92">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource JobStatusToText}}"
                                       Foreground="{Binding Status, Converter={StaticResource JobStatusToBrush}}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 현재 단계 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnStage}"
                                    Binding="{Binding Stage, Converter={StaticResource JobStageToText}}"
                                    Width="112" />

                <!-- 진행률 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnProgress}" SortMemberPath="OverallProgress" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="16"
                                             Value="{Binding OverallProgress, Mode=OneWay}" />
                                <TextBlock Text="{Binding OverallProgress, Converter={StaticResource PercentToText}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 단계 진행률 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnStageProgress}" SortMemberPath="StageProgress" Width="126">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="16"
                                             Foreground="#5B8DEF"
                                             Value="{Binding StageProgress, Mode=OneWay}" />
                                <TextBlock Text="{Binding StageProgress, Converter={StaticResource PercentToText}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 남은 시간 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnRemaining}"
                                    Binding="{Binding EstimatedTimeRemaining, Converter={StaticResource SecondsToTime}}"
                                    Width="92">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 처리 속도 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSpeed}"
                                    Binding="{Binding SpeedText}"
                                    Width="86">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 감지 언어 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnDetectedLanguage}"
                                    Binding="{Binding DetectedLanguage, Converter={StaticResource EmptyToDash}}"
                                    Width="86" />

                <!-- 모델 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnModel}"
                                    Binding="{Binding Model, Converter={StaticResource EmptyToDash}}"
                                    Width="160" />

                <!-- 자막 원본: the per-file override, "기본(음성 인식)" until the user changes it. -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSubtitleSource}"
                                    Binding="{Binding SubtitleSourceText}"
                                    Width="118" />

                <!-- 결과 경로 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnOutputPath}" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OutputPath, Converter={StaticResource EmptyToDash}}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OutputPath}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 오류 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnError}" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#C21E1E"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ErrorMessage}"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
