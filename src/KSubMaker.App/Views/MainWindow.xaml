<Window x:Class="KSubMaker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        xmlns:svc="clr-namespace:KSubMaker.App.Services"
        xmlns:controls="clr-namespace:KSubMaker.App.Controls"
        Title="{x:Static res:Strings.MainWindowTitle}"
        Height="760"
        Width="1600"
        MinHeight="520"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <DockPanel LastChildFill="True">

        <!-- ======================= status bar ======================= -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.QueueStateLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding QueueStateText}" FontWeight="SemiBold" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.CountTotalLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding TotalCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountPendingLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding PendingCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountRunningLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding RunningCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountCompletedLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding CompletedCount}" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static res:Strings.CountFailedLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding FailedCount}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.GpuLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding GpuSummary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               ToolTip="{Binding GpuSummary}" />
                </StackPanel>
            </StatusBarItem>
            <!-- Pre-start model download. Hidden unless a download is actually running. -->
            <StatusBarItem Visibility="{Binding IsPreparingModels, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="140"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ModelPreparationPercent, Mode=OneWay}"
                                 Margin="0,0,8,0" />
                    <Button Content="{x:Static res:Strings.CancelModelPrepareButton}"
                            Command="{Binding CancelModelPreparationCommand}"
                            Padding="8,0" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="620"
                           ToolTip="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <!-- App-level navigation lives in the menu bar, not among the queue buttons: 설정 · 모델 관리 ·
             로그 보기 are not things you do to the list. Each item runs its command directly. -->
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="{x:Static res:Strings.SettingsButton}" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="{x:Static res:Strings.ModelsButton}" Command="{Binding OpenModelsCommand}" />
            <MenuItem Header="{x:Static res:Strings.OpenLogButton}" Command="{Binding OpenLogWindowCommand}" />
            <MenuItem Header="{x:Static res:Strings.DiscordMenuItem}"
                      ToolTip="{x:Static svc:AppLinks.Discord}"
                      Click="OnOpenDiscord" />
        </Menu>

        <!-- =======================================================================
             Top chrome, top to bottom: the target folder + scan options on one row,
             a scan-progress row that collapses when idle, then the command bar. The
             command bar used to be a fifteen-button WrapPanel docked to the bottom
             where it competed with the status bar and gave 시작 no more weight than
             로그 보기; it now sits above the grid it acts on, split into labelled
             groups.
             ======================================================================= -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBackground}"
                BorderBrush="{StaticResource ChromeBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- target folder + scan options: the box takes ~3/5, the trailing star column is
                     the spacer that stops it stretching the full width -->
                <Grid Margin="12,9,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.TargetFolderLabel}"
                               Style="{StaticResource LabelText}" />

                    <TextBox Grid.Column="1"
                             Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditFolder}"
                             Padding="6,5"
                             VerticalContentAlignment="Center"
                             ToolTip="{Binding TargetFolder}" />

                    <Button Grid.Column="2"
                            Content="{x:Static res:Strings.SelectFolderButton}"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" />

                    <Button Grid.Column="3"
                            Content="{x:Static res:Strings.ScanButton}"
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource ToolButton}"
                            Margin="4,0,10,0"
                            ToolTip="{x:Static res:Strings.ScanHint}" />

                    <CheckBox Grid.Column="4"
                              Content="{x:Static res:Strings.IncludeSubfoldersLabel}"
                              IsChecked="{Binding IncludeSubfolders}"
                              Style="{StaticResource OptionCheckBox}" />
                    <CheckBox Grid.Column="5"
                              Content="{x:Static res:Strings.IncludeHiddenFoldersLabel}"
                              IsChecked="{Binding IncludeHiddenFolders}"
                              Style="{StaticResource OptionCheckBox}" />
                </Grid>

                <!-- scan progress: collapses to nothing when no scan is running -->
                <StackPanel Orientation="Horizontal"
                            Margin="12,0,12,8"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{x:Static res:Strings.ScanCancelButton}"
                            Command="{Binding CancelScanCommand}"
                            Style="{StaticResource ToolButton}" />

                    <ProgressBar Width="140"
                                 Height="6"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0" />
                </StackPanel>

                <!-- command bar: each group is a card — its label at the top, its buttons below -->
                <WrapPanel Orientation="Horizontal" Margin="12,4,12,2">

                    <!-- 실행 -->
                    <Border Style="{StaticResource GroupCard}">
                      <StackPanel>
                        <TextBlock Text="실행" Style="{StaticResource GroupCaption}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryToolButton}"
                                    ToolTip="체크한 항목이 있으면 그 항목만, 없으면 대기 중인 전체를 처리합니다.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Fill="White"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StartButtonCaption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4"
                                        ToolTip="영상 앞부분만 잘라 빠르게 한 번 돌려봅니다. ▾ 에서 길이를 고르세요. '시작'은 항상 전체를 처리합니다.">
                                <Button Content="테스트"
                                        Command="{Binding StartTestCommand}"
                                        Style="{StaticResource ToolButton}"
                                        Margin="0" />
                                <Menu Style="{StaticResource CaretMenu}">
                                    <MenuItem Style="{StaticResource CaretMenuItem}">
                                        <MenuItem.Header>
                                            <Path Data="M0,0 L5,5 L10,0 Z" Fill="#242A31"
                                                  Width="9" Height="5" Stretch="Fill" VerticalAlignment="Center" />
                                        </MenuItem.Header>
                                        <MenuItem Header="앞 30초" Command="{Binding StartTestCommand}" CommandParameter="30"
                                                  IsChecked="{Binding TestLengthSeconds, Mode=OneWay, Converter={StaticResource ValueEqualsParameter}, ConverterParameter=30}" />
                                        <MenuItem Header="앞 1분" Command="{Binding StartTestCommand}" CommandParameter="60"
                                                  IsChecked="{Binding TestLengthSeconds, Mode=OneWay, Converter={StaticResource ValueEqualsParameter}, ConverterParameter=60}" />
                                        <MenuItem Header="앞 3분" Command="{Binding StartTestCommand}" CommandParameter="180"
                                                  IsChecked="{Binding TestLengthSeconds, Mode=OneWay, Converter={StaticResource ValueEqualsParameter}, ConverterParameter=180}" />
                                        <MenuItem Header="앞 5분" Command="{Binding StartTestCommand}" CommandParameter="300"
                                                  IsChecked="{Binding TestLengthSeconds, Mode=OneWay, Converter={StaticResource ValueEqualsParameter}, ConverterParameter=300}" />
                                        <MenuItem Header="앞 10분" Command="{Binding StartTestCommand}" CommandParameter="600"
                                                  IsChecked="{Binding TestLengthSeconds, Mode=OneWay, Converter={StaticResource ValueEqualsParameter}, ConverterParameter=600}" />
                                    </MenuItem>
                                </Menu>
                            </StackPanel>

                            <Button Command="{Binding PauseCommand}" Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPause}" Fill="#242A31"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.PauseButton}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconStop}" Fill="#242A31"
                                          Width="10" Height="10" Stretch="Uniform"
                                          Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.StopButton}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 큐 완료 후 동작. Belongs in 실행 because it is part of what
                                 pressing 시작 sets in motion, not a list or selection operation. -->
                            <Rectangle Width="1" Height="22" Fill="#D5D8DD"
                                       Margin="6,0,8,4" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.PostQueueActionCommandLabel}"
                                       Style="{StaticResource LabelText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,4" />
                            <ComboBox ItemsSource="{Binding PostQueueActions}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedPostQueueAction}"
                                      MinWidth="128"
                                      Margin="0,0,4,4"
                                      VerticalAlignment="Center"
                                      ToolTip="{x:Static res:Strings.PostQueueActionHint}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 목록 -->
                    <Border Style="{StaticResource GroupCard}">
                      <StackPanel>
                        <TextBlock Text="목록" Style="{StaticResource GroupCaption}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static res:Strings.RetryButton}"
                                    Command="{Binding RetryCommand}"
                                    Style="{StaticResource ToolButton}" />
                            <Button Content="{x:Static res:Strings.CancelJobButton}"
                                    Command="{Binding CancelJobsCommand}"
                                    Style="{StaticResource ToolButton}" />
                            <Button Content="{Binding RemoveSelectedCaption}"
                                    Command="{Binding RemoveSelectedCommand}"
                                    Style="{StaticResource ToolButton}" />
                            <Button Content="{x:Static res:Strings.RemoveCompletedButton}"
                                    Command="{Binding RemoveCompletedCommand}"
                                    Style="{StaticResource ToolButton}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 선택 -->
                    <Border Style="{StaticResource GroupCard}">
                      <StackPanel>
                        <TextBlock Text="선택" Style="{StaticResource GroupCaption}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static res:Strings.SubtitleSourceMenuItem}"
                                    Command="{Binding ChooseSubtitleSourceCommand}"
                                    Style="{StaticResource ToolButton}" />
                            <!-- 재생목록에 넣기: opens the same choices as the row menu (see OnDropDownButtonClick) -->
                            <Button Content="{x:Static res:Strings.AddToPlaylistButton}"
                                    Click="OnDropDownButtonClick"
                                    Style="{StaticResource ToolButton}">
                                <Button.ContextMenu>
                                    <ContextMenu />
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 열기 -->
                    <Border Style="{StaticResource GroupCard}" Margin="0,0,0,6">
                      <StackPanel>
                        <TextBlock Text="열기" Style="{StaticResource GroupCaption}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static res:Strings.OpenOutputFolderButton}"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    Style="{StaticResource ToolButton}" />
                            <Button Content="{x:Static res:Strings.OpenSourceFolderButton}"
                                    Command="{Binding OpenSourceFolderCommand}"
                                    Style="{StaticResource ToolButton}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============ folder tree | job grid ============
             The tree only switches what the grid shows; work in other folders keeps running. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource ChromeBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" MinHeight="90" />
                </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <DockPanel DockPanel.Dock="Top" Margin="12,10,8,4" MinHeight="24">
                    <Button DockPanel.Dock="Right"
                            Content="{x:Static res:Strings.ReturnToRunningViewButton}"
                            Command="{Binding ReturnToRunningViewCommand}"
                            Visibility="{Binding CanReturnToRunningView, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding RunningViewTitle}"
                            Style="{StaticResource ToolButton}" />
                    <TextBlock Text="{x:Static res:Strings.FolderTreeHeader}"
                               Style="{StaticResource GroupCaption}"
                               Margin="0"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Explorer-like rows: chevron, icon, name; hover and selection fill the whole row -->
                <TreeView ItemsSource="{Binding FolderTree.Roots}"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="4,0,4,6"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          TreeViewItem.Selected="OnFolderTreeItemSelected">
                    <TreeView.Resources>
                        <Style x:Key="TreeChevron" TargetType="ToggleButton">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="Glyph"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="8"
                                                       Foreground="#8A94A3"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="#2B3542" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="Row"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="2,3,6,3"
                                                    ToolTip="{Binding FullPath}">
                                                <Grid Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TreeIndent}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander"
                                                                  Style="{StaticResource TreeChevron}"
                                                                  ClickMode="Press"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <!-- drives: a system glyph; folders: a filled two-tone folder like Explorer's -->
                                                    <TextBlock x:Name="DriveIcon"
                                                               Grid.Column="1"
                                                               Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="#5B6B80"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed" />
                                                    <Canvas x:Name="FolderIcon"
                                                            Grid.Column="1"
                                                            Width="16"
                                                            Height="13"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Path Fill="#E3A42A"
                                                              Data="M0,1.6 C0,0.7 0.7,0 1.6,0 L5.6,0 L7.2,1.8 L14.4,1.8 C15.3,1.8 16,2.5 16,3.4 L16,11.4 C16,12.3 15.3,13 14.4,13 L1.6,13 C0.7,13 0,12.3 0,11.4 Z" />
                                                        <Path Fill="#F9C74F"
                                                              Data="M0,4.4 L16,4.4 L16,11.4 C16,12.3 15.3,13 14.4,13 L1.6,13 C0.7,13 0,12.3 0,11.4 Z" />
                                                    </Canvas>
                                                    <ContentPresenter Grid.Column="2"
                                                                      ContentSource="Header"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                <Setter TargetName="DriveIcon" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#E9EDF3" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#D9E6FB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock x:Name="Label"
                                       Text="{Binding Name}"
                                       Foreground="#1F2733"
                                       TextTrimming="CharacterEllipsis" />
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource ChromeBorder}" />

            <!-- 재생목록: buckets of jobs from any folders; picking one shows it in the grid -->
            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="12,10,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{x:Static res:Strings.NewPlaylistButton}"
                                Command="{Binding NewPlaylistCommand}"
                                Style="{StaticResource ToolButton}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PlaylistsHeader}"
                               Style="{StaticResource GroupCaption}"
                               Margin="0"
                               VerticalAlignment="Center" />
                </DockPanel>

                <ListBox ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.RenamePlaylistButton}"
                                      Command="{Binding PlacementTarget.DataContext.RenamePlaylistCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.DeletePlaylistButton}"
                                      Command="{Binding PlacementTarget.DataContext.DeletePlaylistCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Count}"
                                           Foreground="Gray"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource ChromeBorder}" />

        <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ViewTitle}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ViewTitle}"
                   Margin="10,6,10,4" />
        <controls:JobGrid ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                  AllowDrop="True"
                  DragOver="OnQueueDragOver"
                  Drop="OnQueueDrop"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  RowHeight="26"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="12,6,12,6">

            <!-- Selection is a light tint, not the OS full-saturation blue: the 상태 column paints its
                 own blue/green/red text and the progress %s ride on top of the bars, all of which
                 vanish on a solid blue row. -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E4EEFB" />
                            <Setter Property="BorderBrush" Value="#E4EEFB" />
                            <Setter Property="Foreground" Value="#1F2328" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <!-- Bound to the window's DataContext, not the row's: a ContextMenu lives in its own
                 visual tree, so {Binding ChooseSubtitleSourceCommand} alone would look for the
                 command on JobRowViewModel and silently disable the item. -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.RunThisMenuItem}"
                              FontWeight="SemiBold"
                              Command="{Binding PlacementTarget.DataContext.RunThisJobCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static res:Strings.PlayMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.OpenVideoFileCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.NoteMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.EditNoteCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static res:Strings.SubtitleSourceMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.ChooseSubtitleSourceCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.RenameMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.RenameFileCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static res:Strings.DeleteMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.DeleteFileCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static res:Strings.PropertiesMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.ShowFilePropertiesCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.AddToPlaylistMenuItem}"
                              ItemsSource="{Binding PlacementTarget.DataContext.Playlists,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command"
                                        Value="{Binding PlacementTarget.DataContext.AddToPlaylistCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="{x:Static res:Strings.AddToNewPlaylistMenuItem}"
                              Command="{Binding PlacementTarget.DataContext.AddToNewPlaylistCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="{Binding PlacementTarget.DataContext.RemoveSelectedCaption,
                                               RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Right-click has to select the row before the context menu opens, otherwise
                         "자막 원본 선택" acts on whichever row was last left-clicked. -->
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClick" />

                    <!-- Source path, state, and where the subtitle goes — a plain string so the tooltip
                         content is not a shared visual across every virtualised row. -->
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}&#x0a;{1} · {2}&#x0a;→ {3}">
                                <Binding Path="FullPath" />
                                <Binding Path="StatusText" />
                                <Binding Path="StageText" />
                                <Binding Path="OutputPath" Converter="{StaticResource EmptyToDash}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E4EEFB" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <!-- 선택 -->
                <DataGridTemplateColumn CanUserSort="False" Width="60">
                    <DataGridTemplateColumn.Header>
                        <!-- Select all / none, not a sort: see MainViewModel.AllChecked. -->
                        <CheckBox IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                  Content="{x:Static res:Strings.SelectAllHeader}"
                                  VerticalContentAlignment="Center"
                                  ToolTip="{x:Static res:Strings.ColumnSelected}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 파일명 — 더블클릭하면 기본 플레이어로 재생 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnFileName}" SortMemberPath="FileName" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" ToolTip="{Binding FullPath}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.OpenVideoFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <TextBlock Text="{Binding FileName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 메모 — 더블클릭하거나 우클릭 메뉴에서 편집 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnNote}" SortMemberPath="Note" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" ToolTip="{Binding Note}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <TextBlock Text="{Binding Note}"
                                           Foreground="#5C6672"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 길이 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnDuration}"
                                    Binding="{Binding DurationSeconds, Converter={StaticResource SecondsToTime}}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 용량 — sorts on the raw byte count, not the formatted string -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnFileSize}"
                                    SortMemberPath="FileSizeBytes"
                                    Binding="{Binding FileSizeBytes, Converter={StaticResource BytesToString}}"
                                    Width="84">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 상태: 처리 중이면 단계와 같은 말이라 상태만, 실패·일시정지면 "· 번역까지"로 어디서 멈췄는지 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnStatus}" SortMemberPath="Status" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusSummary}"
                                       Foreground="{Binding Status, Converter={StaticResource JobStatusToBrush}}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 진행: 막대는 작업 전체(자막을 다 쓰면 그때만 가득), 글자는 지금 단계와 그 단계의 % -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnProgress}" SortMemberPath="OverallProgress" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" ToolTip="{Binding OverallText}">
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="16"
                                             Foreground="{Binding Status, Converter={StaticResource JobStatusToProgressBrush}}"
                                             Value="{Binding OverallProgress, Mode=OneWay}" />
                                <TextBlock Text="{Binding ProgressText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#1A1A1A"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 남은 시간 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnRemaining}"
                                    Binding="{Binding EstimatedTimeRemaining, Converter={StaticResource SecondsToTime}}"
                                    Width="92">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 처리 속도 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSpeed}"
                                    Binding="{Binding SpeedText}"
                                    Width="86">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 감지 언어 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnDetectedLanguage}"
                                    Binding="{Binding DetectedLanguage, Converter={StaticResource EmptyToDash}}"
                                    Width="86">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 모델 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnModel}"
                                    Binding="{Binding Model, Converter={StaticResource EmptyToDash}}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 자막 원본: the per-file override, "기본(음성 인식)" until the user changes it. -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSubtitleSource}"
                                    Binding="{Binding SubtitleSourceText}"
                                    Width="118">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 결과 경로는 열 대신 행 툴팁으로: 대개 원본 옆이라 240px를 쓸 값이 아님. "결과 폴더 열기"가 직접 연다. -->

                <!-- 오류 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnError}" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#C21E1E"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ErrorMessage}"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </controls:JobGrid>
        </DockPanel>
        </Grid>

    </DockPanel>
</Window>
