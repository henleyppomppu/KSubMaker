<Window x:Class="KSubMaker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        Title="{x:Static res:Strings.SettingsWindowTitle}"
        Height="720"
        Width="900"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <!-- Esc cancels. Deliberately a KeyBinding rather than IsCancel on the button: IsCancel assigns
         Window.DialogResult itself, which would collide with the assignment the view model's
         CloseRequested handler makes and throw once the dialog has already closed. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}" x:Key="FieldLabel">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="StackPanel" x:Key="FieldRow">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ======================= footer ======================= -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F5F6F8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#A03030" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ProgressBar Width="110"
                                 Height="6"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{x:Static res:Strings.Save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource CommandButton}"
                            IsDefault="True"
                            FontWeight="SemiBold" />
                    <Button Content="{x:Static res:Strings.Cancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource CommandButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="10">

            <!-- =================== 음성 인식 =================== -->
            <TabItem Header="{x:Static res:Strings.TabRecognition}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <GroupBox Header="{x:Static res:Strings.SourceLanguageGroup}">
                            <StackPanel>
                                <CheckBox Content="{x:Static res:Strings.SourceLanguageAuto}"
                                          IsChecked="{Binding IsSourceLanguageAuto}"
                                          Margin="0,0,0,6" />
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.SourceLanguageManual}"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource OptionCombo}"
                                              ItemsSource="{Binding Languages}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedSourceLanguage}"
                                              IsEnabled="{Binding IsSourceLanguageAuto, Converter={StaticResource InverseBoolean}}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.WhisperModelGroup}">
                            <StackPanel>
                                <CheckBox Content="{x:Static res:Strings.WhisperModelAuto}"
                                          IsChecked="{Binding IsWhisperModelAuto}"
                                          Margin="0,0,0,6" />

                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.WhisperModelManual}"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource OptionCombo}"
                                              ItemsSource="{Binding WhisperModels}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedWhisperModel}"
                                              IsEnabled="{Binding IsWhisperModelAuto, Converter={StaticResource InverseBoolean}}" />
                                </StackPanel>

                                <!-- 설치됨 / 미설치 is appended to each entry by ModelOption.Display. -->
                                <TextBlock Text="{x:Static res:Strings.SettingsModelInstallHint}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="#6B6B6B" />

                                <TextBlock Text="{x:Static res:Strings.RecommendationLabel}"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,10,0,2" />
                                <TextBlock Text="{Binding RecommendationText}"
                                           TextWrapping="Wrap"
                                           Foreground="#33507A" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.ComputeTypeLabel}">
                            <StackPanel>
                                <CheckBox Content="{x:Static res:Strings.ComputeTypeAuto}"
                                          IsChecked="{Binding IsComputeTypeAuto}"
                                          Margin="0,0,0,6" />
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.ComputeTypeLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource OptionCombo}"
                                              ItemsSource="{Binding ComputeTypes}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedComputeType}"
                                              IsEnabled="{Binding IsComputeTypeAuto, Converter={StaticResource InverseBoolean}}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.BeamSizeLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding BeamSize, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>

                                <CheckBox Content="{x:Static res:Strings.VadFilterLabel}"
                                          IsChecked="{Binding VadFilter}"
                                          Margin="0,8,0,4" />
                                <CheckBox Content="{x:Static res:Strings.WordTimestampsLabel}"
                                          IsChecked="{Binding WordTimestamps}"
                                          Margin="0,0,0,4" />
                                <CheckBox Content="{x:Static res:Strings.ConditionOnPreviousTextLabel}"
                                          IsChecked="{Binding ConditionOnPreviousText}" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 번역 =================== -->
            <TabItem Header="{x:Static res:Strings.TabTranslation}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <GroupBox Header="{x:Static res:Strings.TranslationEngineGroup}">
                            <StackPanel>
                                <!-- One list, both engines. The engine is a property of the model
                                     that was picked, not a separate decision: choosing an LLM here
                                     switches the run to the LLM engine (see TranslationChoice).
                                     Two controls let a user select an LLM while the engine still
                                     said 전용 번역 모델, which reads as configured and does
                                     nothing. -->
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.TranslationModelLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource OptionCombo}"
                                              ItemsSource="{Binding TranslationModels}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedTranslationModel}" />
                                </StackPanel>

                                <TextBlock Text="{x:Static res:Strings.SettingsModelInstallHint}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="#6B6B6B" />

                                <CheckBox Content="동일 언어 번역 생략 (예: 한국어 음성은 번역하지 않고 그대로 사용)"
                                          IsChecked="{Binding SkipTranslationForSameLanguage}"
                                          Margin="0,8,0,4" />

                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.TranslationStyleLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource OptionCombo}"
                                              ItemsSource="{Binding TranslationStyles}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedTranslationStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.BatchGroup}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.BatchMaxItemsLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding TranslationBatchMaxItems, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.BatchMaxCharsLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding TranslationBatchMaxChars, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.BatchMaxSecondsLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding TranslationBatchMaxSeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.ContextLinesLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding TranslationContextLines, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 고유명사 사전: 원문 → 한국어 pairs applied by both translation engines. -->
                        <GroupBox Header="{x:Static res:Strings.GlossaryGroup}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.GlossaryHint}"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,8" />

                                <DataGrid ItemsSource="{Binding Glossary}"
                                          SelectedItem="{Binding SelectedGlossaryEntry, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          CanUserSortColumns="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0"
                                          RowHeight="24"
                                          Height="180"
                                          Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static res:Strings.GlossarySourceHeader}"
                                                            Binding="{Binding Source, UpdateSourceTrigger=LostFocus}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="{x:Static res:Strings.GlossaryTargetHeader}"
                                                            Binding="{Binding Target, UpdateSourceTrigger=LostFocus}"
                                                            Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox Width="190"
                                             Padding="4,3"
                                             Margin="0,0,6,0"
                                             Text="{Binding NewGlossarySource, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="190"
                                             Padding="4,3"
                                             Margin="0,0,10,0"
                                             Text="{Binding NewGlossaryTarget, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="{x:Static res:Strings.GlossaryAddButton}"
                                            Command="{Binding AddGlossaryEntryCommand}"
                                            Style="{StaticResource CommandButton}" />
                                    <Button Content="{x:Static res:Strings.GlossaryRemoveButton}"
                                            Command="{Binding RemoveGlossaryEntryCommand}"
                                            Style="{StaticResource CommandButton}" />
                                </StackPanel>

                                <TextBlock Text="{Binding GlossaryMessage}"
                                           Foreground="#A03030"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding GlossaryMessage, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 자막 · 출력 =================== -->
            <TabItem Header="{x:Static res:Strings.TabSubtitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <GroupBox Header="{x:Static res:Strings.ExistingSubtitleGroup}">
                            <ComboBox Style="{StaticResource OptionCombo}"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding ExistingSubtitlePolicies}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedExistingSubtitlePolicy}" />
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.OutputConflictGroup}">
                            <StackPanel>
                                <ComboBox Style="{StaticResource OptionCombo}"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding OutputConflictPolicies}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedOutputConflictPolicy}" />

                                <StackPanel Style="{StaticResource FieldRow}" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Static res:Strings.OutputSuffixLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="120"
                                             Padding="4,3"
                                             Text="{Binding OutputSuffix, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <TextBlock Text="{x:Static res:Strings.OutputSuffixHint}"
                                           Style="{StaticResource HintText}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.SubtitleFormatGroup}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.MaxLinesPerCueLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding MaxLinesPerCue, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.MaxCharsPerLineLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding MaxCharsPerLine, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.MinCueDurationLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding MinCueDurationSeconds, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.MaxCueDurationLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding MaxCueDurationSeconds, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.MinCueGapLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding MinCueGapMilliseconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <CheckBox Content="{x:Static res:Strings.MergeShortCuesLabel}"
                                          IsChecked="{Binding MergeShortCues}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 실행 =================== -->
            <TabItem Header="{x:Static res:Strings.TabExecution}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <GroupBox Header="{x:Static res:Strings.ProcessingStrategyGroup}">
                            <StackPanel>
                                <ComboBox Style="{StaticResource OptionCombo}"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding ProcessingStrategies}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedProcessingStrategy}" />

                                <StackPanel Style="{StaticResource FieldRow}" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Static res:Strings.MaxParallelCpuLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding MaxParallelCpuTasks, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FieldRow}" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Static res:Strings.AudioPrefetchDepthLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource NumberBox}"
                                             Text="{Binding AudioPrefetchDepth, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <TextBlock Text="{x:Static res:Strings.AudioPrefetchDepthHint}"
                                           Style="{StaticResource HintText}" />

                                <CheckBox Content="{x:Static res:Strings.AutoRetryLabel}"
                                          IsChecked="{Binding AutoRetryOnRecoverableError}"
                                          Margin="0,8,0,4" />
                                <CheckBox Content="{x:Static res:Strings.FakeAiModeLabel}"
                                          IsChecked="{Binding FakeAiMode}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.ScanDefaultsGroup}">
                            <StackPanel>
                                <CheckBox Content="{x:Static res:Strings.ReprocessCompletedLabel}"
                                          IsChecked="{Binding ReprocessCompleted}"
                                          Margin="0,0,0,4" />
                                <CheckBox Content="{x:Static res:Strings.RetryFailedOnlyLabel}"
                                          IsChecked="{Binding RetryFailedOnly}" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 경로 · 로그 =================== -->
            <TabItem Header="{x:Static res:Strings.TabPaths}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <GroupBox Header="{x:Static res:Strings.PathsGroup}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.CacheDirectoryLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="380" Padding="4,3"
                                             Text="{Binding CacheDirectory, UpdateSourceTrigger=LostFocus}" />
                                    <Button Content="{x:Static res:Strings.Browse}"
                                            Command="{Binding BrowseCacheDirectoryCommand}"
                                            Style="{StaticResource CommandButton}"
                                            Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.ModelDirectoryLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="380" Padding="4,3"
                                             Text="{Binding ModelDirectory, UpdateSourceTrigger=LostFocus}" />
                                    <Button Content="{x:Static res:Strings.Browse}"
                                            Command="{Binding BrowseModelDirectoryCommand}"
                                            Style="{StaticResource CommandButton}"
                                            Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.LogDirectoryLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="380" Padding="4,3"
                                             Text="{Binding LogDirectory, UpdateSourceTrigger=LostFocus}" />
                                    <Button Content="{x:Static res:Strings.Browse}"
                                            Command="{Binding BrowseLogDirectoryCommand}"
                                            Style="{StaticResource CommandButton}"
                                            Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{x:Static res:Strings.PathDefaultHint}"
                                           Style="{StaticResource HintText}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.LoggingGroup}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.LogLevelLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource OptionCombo}"
                                              ItemsSource="{Binding LogLevels}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedLogLevel}" />
                                </StackPanel>
                                <CheckBox Content="{x:Static res:Strings.MaskPathsLabel}"
                                          IsChecked="{Binding MaskPathsInLogs}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 시스템 정보 =================== -->
            <TabItem Header="{x:Static res:Strings.TabSystem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <Button Content="{x:Static res:Strings.Refresh}"
                                Command="{Binding RefreshHardwareCommand}"
                                Style="{StaticResource CommandButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10" />

                        <GroupBox Header="{x:Static res:Strings.GpuInfoGroup}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.GpuNameLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding GpuName}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.VramLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding VramText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.CudaLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CudaText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.DriverLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DriverText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.SystemInfoGroup}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.CpuLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CpuName}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.CoresLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CoreCountText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.RamLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding RamText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="{x:Static res:Strings.DiskLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DiskText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.DetectionWarningsLabel}">
                            <TextBlock Text="{Binding DetectionWarnings}" TextWrapping="Wrap" />
                        </GroupBox>

                        <GroupBox Header="{x:Static res:Strings.RecommendationLabel}">
                            <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" />
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
