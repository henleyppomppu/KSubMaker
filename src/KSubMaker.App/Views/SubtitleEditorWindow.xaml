<Window x:Class="KSubMaker.App.Views.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        Title="{Binding Title}"
        Height="720"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="#F5F6F8" BorderBrush="#E3E6EB" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="{x:Static res:Strings.Save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource CommandButton}"
                            FontWeight="SemiBold"
                            ToolTip="Ctrl+S" />
                    <Button Content="{x:Static res:Strings.OpenInDefaultAppButton}"
                            Command="{Binding OpenExternallyCommand}"
                            Style="{StaticResource CommandButton}" />
                </StackPanel>
                <TextBlock Text="{x:Static res:Strings.SubtitleEditorHint}"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#F5F6F8">
            <DockPanel>
                <!-- Not IsCancel: that only closes a window shown with ShowDialog, and this one is modeless. -->
                <Button DockPanel.Dock="Right"
                        Content="{x:Static res:Strings.Close}"
                        Style="{StaticResource CommandButton}"
                        Click="OnCloseClick" />
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}" />
            </DockPanel>
        </Border>

        <!-- cues: timings read-only, the text edited in place -->
        <DataGrid ItemsSource="{Binding Cues}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECEEF2"
                  RowHeaderWidth="0"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Margin="12,8,12,8">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E4EEFB" />
                            <Setter Property="BorderBrush" Value="#E4EEFB" />
                            <Setter Property="Foreground" Value="#1F2328" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="48">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8A94A3" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,4,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static res:Strings.SubtitleColumnStart}" Binding="{Binding StartText}" IsReadOnly="True" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="Foreground" Value="#5C6672" />
                            <Setter Property="Margin" Value="0,4,0,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static res:Strings.SubtitleColumnEnd}" Binding="{Binding EndText}" IsReadOnly="True" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="Foreground" Value="#5C6672" />
                            <Setter Property="Margin" Value="0,4,0,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="{x:Static res:Strings.SubtitleColumnText}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,3"
                                     FontSize="13" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
